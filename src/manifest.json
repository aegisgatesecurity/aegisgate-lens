{
  "manifest_version": 3,
  "name": "AegisGate Lens",
  "version": "0.1.0",
  "description": "Privacy-first Chrome extension. Detects PII, secrets, XSS, and compliance issues in AI prompts. 100% on-device. Free.",
  "author": "AegisGate Security, LLC",
  "homepage_url": "https://aegisgatesecurity.io/lens",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AegisGate Lens",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://duck.ai/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*",
        "https://grok.com/*",
        "https://www.grok.com/*",
        "https://chat.mistral.ai/*",
        "https://le-chat.mistral.ai/*"
      ],
      "js": [
        "bootstrap.js",
        "util/constants.js",
        "util/typedefs.js",
        "util/logger.js",
        "detectors/luhn.js",
        "detectors/regex/pii.js",
        "detectors/regex/secrets.js",
        "detectors/regex/source_xss.js",
        "detectors/regex/compliance.js",
        "privacy/schema.js",
        "privacy/domain_hash.js",
        "detectors/index.js",
        "util/selectors.js",
        "util/prompt-detect.js",
        "util/banner-icons.js",
        "util/dismiss.js",
        "util/banner-ui.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://lens.aegisgatesecurity.io/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "util/banner.css",
        "icons/logo.png",
        "icons/icon-48.png",
        "icons/icon-32.png",
        "icons/icon-16.png",
        "icons/icon-128.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "minimum_chrome_version": "116"
}
