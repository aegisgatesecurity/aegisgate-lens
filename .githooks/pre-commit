#!/bin/bash
# AegisGate Lens — OPSEC pre-commit hook
#
# Delegates to tools/opsec-scan.sh --staged for consistency.
#
# Install:  git config core.hooksPath .githooks
# Or:       cp .githooks/pre-commit .git/hooks/pre-commit
#
# Apache 2.0. Copyright 2026 AegisGate Security, LLC.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

exec "$REPO_ROOT/tools/opsec-scan.sh" --staged