# AegisGate Lens v0.2.0 — .gitignore
#
# Policy: this repo has ZERO third-party dependencies. No npm, no PyPI,
# no Go modules in this repo. The vendored chromedp dep used by the E2E
# tests lives in the Platform monorepo, not here. See docs/NO-EXTERNAL-DEPS.md.
#
# Apache 2.0. See LICENSE.

# --- Build outputs (generated by tools/build/main.go) ---
dist/
build/
out/
*.zip
*.crx
*.xpi
lens-v*/
SHA256SUMS

# --- npm artifacts (this repo must NEVER contain any of these) ---
package.json
package-lock.json
yarn.lock
pnpm-lock.yaml
node_modules/
.npm
.yarn

# --- Python artifacts (defensive; no Python in v0.1.0-beta) ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.venv/

# --- Go artifacts (the build tool is in this repo; no vendored modules) ---
# Allow go.mod / go.sum if added later.

# --- ML model bundles ---
# v0.3.0+: Allow INT8-quantized model for on-device inference
*.bundle
*.tflite
# *.bundle and *.tflite are build artifacts
*.bundle
*.tflite
models/*
!models/threat_cnn_bilstm_weights.bin.json
lens_ml_build/
corpora/

# --- Signing keys (private keys MUST NOT be committed) ---
keys/*.priv.pem
keys/*.private.pem
keys/*-private.key
keys/id_rsa
keys/id_rsa.pub

# --- Editor / OS ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*.bak
*.tmp
*~

# --- Logs / env ---
*.log
.env
.env.local
.env.*.local

# --- Coverage / test artifacts ---
coverage/
*.lcov
.nyc_output/
test-results/
test/output/

# --- Local-only notes (not part of the public repo) ---
NOTES.md
TODO-local.md
.claude/
.aegis_todo.md

# --- Chrome / Firefox test profiles (created during manual E2E) ---
.chrome-*/
.firefox-profile-*/

# --- Go test scratch ---
.test-scratch/

# --- Backup of legacy lens code (if accidentally copied in) ---
.v0.*-mirror*/
.v0.*-mirror-backup/

# --- Release artifacts (committed only as git tags, never as files) ---
release/

# Headless smoke test (Phase 6) - build artifacts and runtime only
# Keep: go.mod, go.sum, *.go files, dist/ (the test bundle)
# Ignore: built binary, runtime logs and reports
test/headless-smoke/headless-smoke-bin
test/headless-smoke/logs/
test/headless-smoke/reports/
test/headless-smoke/piml-runner
test/headless-smoke/bundle.js

# --- Private Lens development directories (per user directive 2026-07-07) ---
# /.plans/ — repo for Lens plans, lessons, retrospectives (gitignored parent per user)
# /.workingdirectory/ — AI working directory (not /tmp/ per Standing Rule 2.1)
.plans/
.plans/v0.2-burndown/
.workingdirectory/

# Benchmark data + results (private, gitignored per standing rule)
test/benchmarks/
test/benchmarks/corpus/
test/benchmarks/results/
test/benchmarks/reports/
test/benchmarks/qa-logs/

# --- Large untracked directories that must NEVER be scanned or committed ---
# These existed at runtime but bloat the working tree; they are loaded by
# separate download scripts in tools/ if needed, never checked in.
models/ministral-3-3b/
models/pi-v0.1.0-beta/
models/toxicity-v0.1.0-beta/
models/gemma-2b/
models/embeddedgemma-2b/

# --- Heavy corpora and headless-smoke runtime artifacts ---
# (corpora is on-demand downloaded by tools/train/; keep out of CI scans)
corpora/

# --- Build / cache artifacts ---
.cache/
node_modules/
*.log
*.tmp
*.bak

# v0.1.2 F-5: burned-down v0.2.0 research artifacts
docs/PHASE-5*

# v0.1.2 F-5: burned-down v0.2.0 research artifacts
docs/VERIFICATION-3*

# v0.1.2 F-5: burned-down v0.2.0 research artifacts
docs/TRAINING-RUN-1*
smoke-report.json

# v0.1.3 cleanup: moved to .plans/v0.2-burndown/
docs/PHASE-0B-*
docs/PHASE-6-*

# --- OPSEC v0.1.4: private keys, internal docs, build artifacts ---
# Private keys and certs MUST NOT be committed (rotated 2026-07-27)
# The headless-smoke mock server generates self-signed TLS certs at
# runtime in Go code (tools/headless-smoke/mock.go) — those are never
# written to disk. The CWS screenshot mock had committed certs; those
# have been removed and must never return.
test/headless-smoke/mock/cws-screenshots/key.pem
test/headless-smoke/mock/cws-screenshots/cert.pem
keys/*.priv.pem
keys/*.private.pem
keys/*-private.key

# Internal/operational docs (not for public repo)
docs/FACTS.md
docs/METRICS-v0.1.2.md
docs/THREAT-MODEL-v0.1.0-BETA.md
docs/ARCHITECTURE-v0.1.0-BETA.md
docs/BANNER-DESIGN-SPEC-v0.1.0-BETA.md
docs/A11Y-AUDIT-v0.1.0-BETA.md
.github/RUNBOOK.md
test/headless-smoke/STATUS.md

# Build artifacts (built by CI, not committed)
test/headless-smoke/mini-smoke-bin

# Lighthouse CI fake test fixtures (local only)
.lighthouseci-fake-*/
